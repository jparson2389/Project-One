# --- Build & Distribution ---
dist/
build/
*.egg-info/

# Explicitly ignore these exact files
Notes.txt
structure.txt
STRUCTUREDOUTPUT.md
UPDATE.md
Layout-Endgoal.txt
.tmp.drivedownload/
.tmp.driveupload/

